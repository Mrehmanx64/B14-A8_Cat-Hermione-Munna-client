# ---------------------------------------------------------------------------
# Shongkolpo client (Next.js) — copy to .env.local and fill in real values.
# ---------------------------------------------------------------------------

# URL of the Express API. Local dev: http://localhost:5000
# Production: the deployed server URL, e.g. https://shongkolpo-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# MongoDB Atlas connection string. BetterAuth stores users/sessions here,
# in the same database the Express API reads events from.
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=shongkolpo

# Public URL this Next.js app is served from. Used as the BetterAuth base URL
# and as the JWT issuer/audience, so the server can verify tokens with it.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# Optional. Only needed if the auth endpoints are served from a different
# origin than this app. Leave blank for same-origin (the normal setup).
NEXT_PUBLIC_APP_URL=

# Long random string used to sign sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-32-byte-random-hex-string

# Optional OAuth providers. Leave blank to hide those buttons.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
